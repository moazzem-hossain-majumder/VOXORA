# ==============================================================================
# VOXORA - AI Speaking Companion Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your keys.
# VOXORA includes a built-in zero-config offline/demo fallback mode, so it works
# even before you configure third-party API keys!
# ==============================================================================

# AI PROVIDERS (At least one recommended for live AI responses)
# Priority order: Groq (ultra-fast free tier) -> Google Gemini -> OpenRouter -> Intelligent Built-in Fallback

# 1. Groq API (Recommended for ultra-fast, low-latency conversational speech)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API (Alternative free tier)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenRouter API (Access to free / open models such as meta-llama/llama-3.1-8b-instruct:free)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Selected active AI provider: "groq" | "gemini" | "openrouter" | "auto"
AI_PROVIDER=auto

# ==============================================================================
# DATABASE & AUTHENTICATION (SUPABASE)
# ==============================================================================
# Get your project URL and Anon Key from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
